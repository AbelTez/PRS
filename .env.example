# Copy to server/.env
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=erl
PGPASSWORD=erl
PGDATABASE=erl_dev
PG_POOL_MAX=10

PORT=3000

# CHANGE THESE BEFORE ANY DEPLOYMENT
JWT_SECRET=dev-only-secret-change-me
TOKEN_SECRET=dev-token-secret-change-me
HASH_PEPPER=dev-pepper
JWT_TTL=12h

# Seed password for all demo users
SEED_PASSWORD=Password123!

# Set true to stop the cron clocks (SLA breach, arrival grace, lost-to-follow-up).
# The e2e test suite triggers them manually via POST /v1/admin/run-schedulers.
DISABLE_SCHEDULER=false
