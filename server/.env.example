# Copy to server/.env

# ---------------------------------------------------------------- DATABASE
# Local development: discrete variables (PGPORT=5433 for the Docker compose DB)
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=erl
PGPASSWORD=erl
PGDATABASE=erl_dev
PG_POOL_MAX=10

# Managed Postgres (Neon/Supabase/RDS) — set INSTEAD of the PG* variables above.
# Takes precedence when present; TLS is enabled automatically for sslmode=require.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# PGSSL_NO_VERIFY=false

PORT=3000

# ----------------------------------------------------------------- SECRETS
# CHANGE THESE BEFORE ANY DEPLOYMENT (generate with: openssl rand -base64 36)
JWT_SECRET=dev-only-secret-change-me
TOKEN_SECRET=dev-token-secret-change-me
HASH_PEPPER=dev-pepper
JWT_TTL=12h

# Seed password for all demo users
SEED_PASSWORD=Password123!

# Set true to stop the referral clocks (SLA breach, arrival grace,
# lost-to-follow-up) — both the cron and the request-driven tick.
# The e2e suites set this and trigger them via POST /v1/admin/run-schedulers.
DISABLE_SCHEDULER=false
# Optional WebRTC relay for consultation calls across restrictive networks.
# Configure either TURN_SHARED_SECRET or TURN_USERNAME + TURN_PASSWORD.
# TURN_URLS=turn:relay.example.org:3478,turns:relay.example.org:5349
# TURN_SHARED_SECRET=
# TURN_USERNAME=
# TURN_PASSWORD=
# CONSULTATION_STUN_URL=stun:stun.l.google.com:19302

# ----------------------------------------------------------- AI ASSISTANT
# Lightweight Gemini assistant (demo). Server-side only — never put the key in
# a VITE_* variable. The free tier may use prompts to improve Google products:
# synthetic/demo data only.
AI_ENABLED=false
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash
AI_FALLBACK_MODELS=gemini-3.8-flash,gemini-flash-lite-latest
AI_TIMEOUT_MS=20000
AI_RATE_PER_MIN=8
